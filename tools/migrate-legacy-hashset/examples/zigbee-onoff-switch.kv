# Iotonekit modelling example — Zigbee HA1.2 OnOff Switch
# Source: ProjectMagNET/reference-designs/MagNET_M5DialFiddlerCrab/docs/iotonekit_modelling_with_udm.txt
# Format: paired K<n>=<key> / V<n>=<value> lines (legacy iotonekit style)
K1=udm_version
V1="0.9.1"
K2=udm_key
V2="iotone-proto-switch-1"
K3=udm_model_name
V3="IoTone Proto Switch 1"
K4=udm_model_number
V4="IOTONE-SWI-P1"
K5=udm_oem
V5="IoTone"
K6=udm_uuid
V6="1a8748bf-9c13-46ab-a762-e463376a1f27"
K7=udm_os
V7="Zigbee HA1.2"
K8=udm_endpoints_x
V8="1"
K9="1:udm_type:OnOff Switch"
V9="0103"
K10=udm_profile
V10="0000"
K11=udm_serialno
V11="1a8748bf-9c13-46ab-a762-e463376a1f27"
K12="1:udm_capability_x:Identify"
V12="0003"
K13="1:udm_capability_x:Identify:_"
V13="0"
K14="1:udm_capability_x:OnOff"
V14="0006"
K15="1:udm_capability_x:OnOff:_"
V15="1"
K16="1:udm_capabilities_x"
V16="Identify,OnOff"
K17=udm_types_x
V17="OnOff Switch"
K18=udm_display_types_x
V18="OnOff Light Switch"
K19="udm_endpoints_x:_"
V19="01"
K20="udm_model_name:_"
V20="Proto Switch 1"
