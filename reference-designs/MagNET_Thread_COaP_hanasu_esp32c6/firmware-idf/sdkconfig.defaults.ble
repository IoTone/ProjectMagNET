# BLE provisioning build (§11.2.1). Layered on top of sdkconfig.defaults.esp32c6,
# which sets CONFIG_BT_ENABLED=n — this file flips it on for the esp32c6_ble env.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# Keep legacy pairing available as well as Secure Connections: with
# SC-only, a peer that does not complete the SC exchange leaves SMP
# stalled until it times out (enc_change status=13) with no fallback.
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
