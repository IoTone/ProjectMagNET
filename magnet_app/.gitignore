# =============================================================================
# Meshmore SNS — Flutter app .gitignore
#
# Based on the canonical `flutter create` template (Flutter 3.24+) with
# additions for FVM, Fleet, test coverage, and pubspec_overrides.
# =============================================================================

# ----- OS / Misc -----
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# ----- IDEs / Editors -----
# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/
# JetBrains Fleet
.fleet/
# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# ----- Flutter / Dart / Pub -----
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# Local-only dependency overrides (developer machine only — never commit).
pubspec_overrides.yaml
# DevTools per-project settings (machine-specific).
.devtools_options.yaml

# Flutter Version Manager (https://fvm.app)
.fvm/

# This is an APP project — pubspec.lock MUST be checked in for
# deterministic builds. Negate any upper-level rule that would ignore it.
!pubspec.lock

# ----- Test coverage -----
coverage/
*.lcov

# ----- Symbolication -----
app.*.symbols

# ----- Obfuscation -----
app.*.map.json

# ----- Android (build artifacts placed here by Android Studio) -----
/android/app/debug
/android/app/profile
/android/app/release

# ----- Signing material — NEVER commit -----
# (key.properties and keystores are also ignored by android/.gitignore;
#  belt-and-braces here in case someone drops them outside android/.)
**/key.properties
**/*.keystore
**/*.jks
**/*.p8
**/*.p12
**/*.mobileprovision

# ----- macOS / iOS local Cocoapods caches (also covered by platform ignores) -----
**/Pods/
**/.symlinks/
