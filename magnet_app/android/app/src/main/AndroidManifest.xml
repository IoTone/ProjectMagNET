<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluetooth LE scanning + connection.
         BLUETOOTH / BLUETOOTH_ADMIN cover pre-Android 12; on API 31+
         the granular SCAN / CONNECT runtime permissions apply. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- neverForLocation: this app scans BLE to find and configure MagNET
         nodes, never to infer where the user is. Without this flag Android 12+
         withholds *all* scan results unless PRECISE location is granted — the
         scan appears to run and silently returns nothing
         ("Permission denial: Need ACCESS_FINE_LOCATION permission to get scan
         results" in the system log). WiFi scanning still uses location
         separately; these are independent. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- WiFi scanning. ACCESS_WIFI_STATE reads results; CHANGE_WIFI_STATE
         lets the app trigger a scan; NEARBY_WIFI_DEVICES is the API 33+
         runtime permission for nearby WiFi without location. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <!-- Location is required for BLE + WiFi scan results on Android
         <= 12. FINE is needed for full WiFi scan results. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- BLE is used but not strictly required (WiFi scanning still
         works on devices without BLE). -->
    <uses-feature android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:label="MagNET"
        android:name="${applicationName}"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
